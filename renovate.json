{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>jay-withers/template-renovate"],
  "autoApprove": true,
  "flux": {
    "managerFilePatterns": ["/^gitops/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^gitops/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.terraform-version$/"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.tflint\\.hcl$/"],
      "matchStrings": [
        "plugin \"azurerm\" \\{[^}]*version\\s*=\\s*\"(?<currentValue>[^\"]+)\"[^}]*source\\s*=\\s*\"github\\.com/(?<depName>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
