{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>jay-withers/template-renovate"],
  "autoApprove": true,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["\\.github/workflows/ci-pre-commit\\.yml$"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/v(?<currentValue>[\\d.]+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["\\.github/workflows/ci-pre-commit\\.yml$"],
      "matchStrings": [
        "pip install (?<depName>[a-z0-9-]+)==(?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ]
}
