# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Note: *.tfvars are intentionally NOT ignored — they hold environment config,
# not secrets. Secrets belong in a secret store / env vars / CI, never in tfvars.

# CLI configuration and override files
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Provider lock file — not committed for a reusable module (consumers generate
# their own); commit it instead if you repurpose this repo as a root config.
.terraform.lock.hcl

# Saved plan output
*.tfplan
